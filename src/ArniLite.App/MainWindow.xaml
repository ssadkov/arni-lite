<Window x:Class="ArniLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArniLite"
        Title="Arni Lite" Width="1180" Height="720" MinWidth="840" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#FAFAF8"
        FontFamily="Segoe UI" FontSize="14" Foreground="#242824"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="Window_OnSizeChanged" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <local:BoolVisibilityConverter x:Key="BoolVis" />
        <local:CodeFontConverter x:Key="CodeFont" />
        <local:FolderNameConverter x:Key="FolderName" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1C1C1C" />
            <Setter Property="BorderBrush" Value="#D7D7D2" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F7F7F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#6A6A66" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Копировать" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Width="28" Height="28">
                            <Viewbox Width="14" Height="14">
                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent"
                                      Data="M5 7h7v8H5z M8 7V5h7v8h-2" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E7E5E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1C1C1C" />
            <Setter Property="BorderBrush" Value="#1C1C1C" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#1C1C1C" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="MenuTop" TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="Head" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,4">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="False" Focusable="False" PopupAnimation="None"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PlacementTarget="{Binding ElementName=Head}">
                    <Border Background="White" BorderBrush="#808080" BorderThickness="1" Padding="2" MinWidth="220" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Head" Property="Background" Value="#E6E6E6" />
                    <Setter TargetName="Head" Property="BorderBrush" Value="#B0B0B0" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Head" Property="Background" Value="#E6E6E6" />
                    <Setter TargetName="Head" Property="BorderBrush" Value="#808080" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="MenuSub" TargetType="MenuItem">
            <Border x:Name="Row" Background="Transparent" Padding="8,5" SnapsToDevicePixels="True">
                <DockPanel>
                    <Path x:Name="Mark" DockPanel.Dock="Left" Width="12" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                          Visibility="Collapsed" Stroke="#1C1C1C" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Data="M1,5 L4,8 L11,1" Fill="Transparent" />
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#D6E3F6" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#1C1C1C" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource MenuTop}" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource MenuTop}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource MenuSub}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource MenuSub}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#D0D0D0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#E7EAE3" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DEE6D9" /><Setter Property="Foreground" Value="#21402C" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#42644B" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter TargetName="Row" Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,16,0,4" /></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ChatEntry">
            <TextBlock Text="{Binding Title}" Margin="18,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
        </DataTemplate>
        <DataTemplate x:Key="ProjectEntry">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="+" Padding="6,2" FontSize="17" Style="{StaticResource QuietButton}"
                        ToolTip="Новый чат в проекте" AutomationProperties.Name="Новый чат в проекте"
                        Command="{Binding DataContext.Chat.NewProjectChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding ProjectPath}" />
                <Button Style="{StaticResource QuietButton}" Padding="6,3" HorizontalContentAlignment="Left"
                        ToolTip="{Binding ProjectPath}"
                        Command="{Binding DataContext.Chat.ToggleProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding ProjectPath}">
                    <DockPanel>
                        <TextBlock Text="{Binding Disclosure}" Width="18" Foreground="#758071" />
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#616B5E" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="TranscriptItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TranscriptList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="True" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="248" />
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition x:Name="InspectorColumn" Width="0" MaxWidth="560" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Navigation" Background="#EFF1EB" BorderBrush="#E3E6DE" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="8,0,4,22">
                        <TextBlock Text="arni" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="LITE" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#76816E" FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                    <Button Content="Новый чат" Command="{Binding Chat.NewChatCommand}" Style="{StaticResource PrimaryButton}"
                            HorizontalContentAlignment="Left" Padding="14,10" ToolTip="Новый общий чат · Ctrl+N" Click="NewChat_OnClick" />
                    <Border Background="#E5E8E0" CornerRadius="7" Margin="0,10,0,2" Padding="10,8">
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding Chat.Search, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13"
                                     AutomationProperties.Name="Поиск чатов" />
                            <TextBlock Text="Поиск чатов" Foreground="#76816E" FontSize="13" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Chat.Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Добавить проект…" Margin="0,14,0,12" HorizontalContentAlignment="Left"
                            Style="{StaticResource QuietButton}" Command="{Binding Chat.ChooseFolderCommand}" />
                    <Border Height="1" Background="#DCE1D5" Margin="0,0,0,14" />
                    <Border Background="#F9FAF6" BorderBrush="#DCE1D5" BorderThickness="1" CornerRadius="9" Padding="10"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding Chat.RefreshAccountCommand}" Style="{StaticResource QuietButton}" Padding="3,1" FontSize="10" />
                                <TextBlock Text="АККАУНТ" FontSize="10" Foreground="#76816E" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding Chat.AccountTitle}" ToolTip="{Binding Chat.AccountTitle}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Chat.Account.AccountType}" FontSize="11" Foreground="#6B7465" Margin="0,4,0,7" />
                            <ItemsControl ItemsSource="{Binding Chat.Account.LimitLines}" ToolTip="{Binding Chat.Account.ResetInfo}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Chat.Account.ResetInfo}" TextWrapping="Wrap" Foreground="#76816E" FontSize="10" />
                            <TextBlock Text="Обновляем данные…" FontSize="10" Foreground="#76816E" Margin="0,5,0,0" Visibility="{Binding Chat.AccountLoading, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding Chat.AccountError}" FontSize="11" Foreground="#93622D" TextWrapping="Wrap" Margin="0,5,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Chat.AccountError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="8,0" Text="Ваши чаты — на этом компьютере" FontSize="11" Foreground="#6B7465" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <Button Content="Войти в Arni" Margin="0,10,0,0" Command="{Binding SignInCommand}" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <Menu Margin="0,10,0,0" Background="Transparent">
                        <MenuItem Header="Настройки">
                            <MenuItem Header="Только бесплатные модели" IsCheckable="True" IsChecked="{Binding Chat.FreeOnly}" IsEnabled="{Binding Chat.CanChangeContext}" />
                            <MenuItem Header="Действия без подтверждения в сеансе" IsCheckable="True" IsChecked="{Binding Chat.TrustSession}" IsEnabled="{Binding Chat.CanChangeContext}" />
                            <Separator />
                            <MenuItem Header="Открыть проект в проводнике" Command="{Binding Chat.OpenInExplorerCommand}" />
                            <MenuItem Header="Выйти из аккаунта" Command="{Binding SignOutCommand}" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}}" />
                            <MenuItem Header="Закрыть Arni Lite" Command="{Binding CloseCommand}" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <ListBox ItemsSource="{Binding Chat.ChatRows}" SelectedItem="{Binding Chat.SelectedEntry, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource NavigationItem}" IsEnabled="{Binding Chat.CanChangeContext}"
                         AutomationProperties.Name="Проекты и чаты">
                    <ListBox.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                        <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource ChatEntry}" /><Style.Triggers><DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ProjectEntry}" /></DataTrigger></Style.Triggers></Style></ContentControl.Style>
                    </ContentControl></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="#E9EBE5" BorderThickness="0,0,0,1" Padding="16,14">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Проекты" Style="{StaticResource QuietButton}" Margin="0,0,12,0" Click="ToggleNavigation_OnClick" ToolTip="Показать или скрыть проекты · Ctrl+B" />
                    <Button x:Name="FilesButton" DockPanel.Dock="Right" Content="Файлы" Style="{StaticResource QuietButton}" Click="ToggleFiles_OnClick" ToolTip="Файлы проекта · Ctrl+Shift+E" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Chat.ChatTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Chat.ProjectName}" ToolTip="{Binding Chat.ProjectPath}" FontSize="11" Foreground="#758071" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <ListBox x:Name="Transcript" Style="{StaticResource TranscriptList}" ItemContainerStyle="{StaticResource TranscriptItem}"
                         ItemsSource="{Binding Chat.Items}" ScrollViewer.ScrollChanged="Transcript_OnScrollChanged"
                         AutomationProperties.Name="Переписка">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="28,8,28,12">
                                <Border x:Name="Message" MaxWidth="760" Padding="0,8" HorizontalAlignment="Stretch">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" AutomationProperties.Name="Копировать сообщение" />
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#71806A" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True"
                                                 FontFamily="Consolas" FontSize="13" Text="{Binding Body, Mode=OneWay}" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                                 Visibility="{Binding IsCodeBlock, Converter={StaticResource BoolVis}}" />
                                        <Expander Header="Подробности действия" FontSize="11" Foreground="#71806A" Visibility="{Binding IsTool, Converter={StaticResource BoolVis}}">
                                            <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True"
                                                     Foreground="#242824" FontFamily="Consolas" FontSize="12" Text="{Binding Body, Mode=OneWay}" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                                        </Expander>
                                        <local:MarkdownView Source="{Binding Body}" Visibility="{Binding IsCode, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Message" Property="Background" Value="#EBEEE5" />
                                    <Setter TargetName="Message" Property="CornerRadius" Value="12" />
                                    <Setter TargetName="Message" Property="Padding" Value="16,12" />
                                    <Setter TargetName="Message" Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCode}" Value="True">
                                    <Setter TargetName="Message" Property="Background" Value="#F0F1ED" />
                                    <Setter TargetName="Message" Property="BorderBrush" Value="#E3E6DD" />
                                    <Setter TargetName="Message" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="Message" Property="CornerRadius" Value="8" />
                                    <Setter TargetName="Message" Property="Padding" Value="12" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel MaxWidth="430" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Chat.Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="С чего начнём?" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Задайте вопрос или выберите проект,&#10;чтобы работать с файлами вместе с Arni."
                               FontSize="14" Foreground="#7A8273" TextAlignment="Center" Margin="0,12,0,24" />
                    <Button Content="Открыть проект" Command="{Binding Chat.ChooseFolderCommand}" HorizontalAlignment="Center" Padding="20,9" />
                    <TextBlock Text="Для новых запросов войдите в аккаунт" FontSize="12" Foreground="#7A8273" TextAlignment="Center" Margin="0,16,0,0"
                               Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                </StackPanel>
                <Button x:Name="LatestButton" Content="К последнему ответу" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,12" Click="Latest_OnClick" Visibility="Collapsed" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="24,8,24,14" MaxWidth="820">
                <Border Background="#F0F3EB" BorderBrush="#D9E2D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                        Visibility="{Binding HasUserCode, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Завершите вход в браузере" FontWeight="SemiBold" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Остановить вход" Style="{StaticResource QuietButton}" Command="{Binding StopCommand}" />
                            <Button DockPanel.Dock="Right" Content="Скопировать код" Style="{StaticResource QuietButton}" Command="{Binding CopyCodeCommand}" />
                            <TextBlock Text="{Binding UserCode}" FontFamily="Consolas" FontSize="20" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button Content="Скопировать ссылку для входа" Style="{StaticResource QuietButton}" Command="{Binding CopyLinkCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Background="#FFF6E8" BorderBrush="#E9D4AC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                        Visibility="{Binding Chat.PermissionVisible, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Chat.PermissionTitle}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Chat.PermissionBody, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MaxHeight="130" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,8" />
                        <StackPanel Orientation="Horizontal"><Button Content="Разрешить" Command="{Binding Chat.AllowCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" /><Button Content="Отклонить" Command="{Binding Chat.DenyCommand}" /></StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Chat.Activity}" Foreground="#64765A" FontSize="12" Margin="4,0,0,8" Visibility="{Binding Chat.HasActivity, Converter={StaticResource BoolVis}}" />
                <Border Background="White" BorderBrush="#DDE2D6" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid MinHeight="52">
                            <TextBox x:Name="Draft" Text="{Binding Chat.Draft, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" MaxHeight="140"
                                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="Draft_OnPreviewKeyDown" AutomationProperties.Name="Сообщение Arni" />
                            <TextBlock Text="Напишите задачу…" Foreground="#969E8E" IsHitTestVisible="False" Margin="1,2,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Chat.Draft}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <DockPanel Grid.Row="1" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="Отправить" Style="{StaticResource PrimaryButton}" Command="{Binding Chat.SendCommand}"
                                    Visibility="{Binding Chat.IsBusy, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                            <Button DockPanel.Dock="Right" Content="Остановить" Command="{Binding Chat.StopCommand}"
                                    Visibility="{Binding Chat.IsBusy, Converter={StaticResource BoolVis}}" />
                            <Grid Margin="0,0,10,0" IsEnabled="{Binding Chat.CanChangeContext}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Агент" FontSize="11" Foreground="#64765A" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Arni отвечает на вопросы и использует инструменты, когда это нужно" />
                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <ComboBox ItemsSource="{Binding Chat.Models}" SelectedItem="{Binding Chat.SelectedCatalog}" BorderThickness="0" Background="#F4F5F0" Padding="5" VerticalAlignment="Center" ToolTip="Модель · фильтр бесплатных моделей в настройках" AutomationProperties.Name="Модель" />
                                    <TextBlock Text="{Binding Chat.ModelStatus}" Foreground="#7D8773" FontSize="11" Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Chat.SelectedCatalog}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Border>
                <TextBlock Text="Enter — отправить · Shift+Enter — новая строка" FontSize="10" Foreground="#8B9482" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
        </Grid>

        <Border x:Name="Inspector" Grid.Column="2" Background="#F4F5F0" BorderBrush="#E0E4D9" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Закрыть" Style="{StaticResource QuietButton}" Click="ToggleFiles_OnClick" FontSize="11" /><TextBlock Text="Файлы проекта" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                    <TextBlock Text="{Binding Chat.ProjectName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Chat.ProjectPath}" />
                    <TextBlock Text="Просмотр не отправляет файлы модели" FontSize="10" Foreground="#7D8773" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <Button Content="Открыть в проводнике" Command="{Binding Chat.OpenInExplorerCommand}" Margin="0,0,0,18" FontSize="12" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Предпросмотр: до 500 строк · до 1 МиБ" FontSize="10" Foreground="#8B9482" TextWrapping="Wrap" Margin="0,12,0,0" />
                <Grid>
                    <StackPanel Visibility="{Binding Chat.HasProject, Converter={StaticResource BoolVis}, ConverterParameter=invert}" Margin="0,20">
                        <TextBlock Text="У этого чата нет проекта" FontWeight="SemiBold" />
                        <TextBlock Text="Добавьте папку, чтобы открыть новый чат с доступом к её файлам." Foreground="#7D8773" TextWrapping="Wrap" Margin="0,8,0,16" />
                        <Button Content="Добавить проект" Command="{Binding Chat.ChooseFolderCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Chat.ProjectFiles}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Style><Style TargetType="ListBox"><Style.Triggers>
                            <DataTrigger Binding="{Binding Chat.HasProject}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Chat.HasFilePreview}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></ListBox.Style>
                        <ListBox.ItemTemplate><DataTemplate><Button Content="{Binding}" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Padding="8" FontSize="12"
                            Command="{Binding DataContext.Chat.OpenProjectFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Visibility="{Binding Chat.HasFilePreview, Converter={StaticResource BoolVis}}">
                        <StackPanel DockPanel.Dock="Top"><Button Content="К списку файлов" Command="{Binding Chat.ClosePreviewCommand}" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" /><TextBlock Text="{Binding Chat.FilePreviewTitle}" FontWeight="SemiBold" Margin="0,12" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <TextBox Text="{Binding Chat.FilePreviewBody, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
        <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Right"
                      ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" ShowsPreview="True"
                      Background="Transparent" Visibility="Collapsed" ToolTip="Изменить ширину панели файлов" />
    </Grid>
</Window>
