<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:ArniLite" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArniLite.MainWindow" Title="Arni Lite" Width="1180" Height="720" MinWidth="840" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#FAFAF8" FontFamily="Segoe UI" FontSize="14" Foreground="#242824" UseLayoutRounding="True" SnapsToDevicePixels="True" SizeChanged="Window_OnSizeChanged" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="248" />
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition x:Name="InspectorColumn" Width="0" MaxWidth="560" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Navigation" Background="#EFF1EB" BorderBrush="#E3E6DE" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="8,0,4,22">
                        <TextBlock Text="arni" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="LITE" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#76816E" FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                    <Button Content="{local:Loc NewChat}" Command="{Binding Chat.NewChatCommand}" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left" Padding="14,10" ToolTip="{local:Loc NewChatTip}" Click="NewChat_OnClick" />
                    <Border Background="#E5E8E0" CornerRadius="7" Margin="0,10,0,2" Padding="10,8">
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding Chat.Search, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13" AutomationProperties.Name="{local:Loc SearchChats}" />
                            <TextBlock Text="{local:Loc SearchChats}" Foreground="#76816E" FontSize="13" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="{local:Loc AddProjectEllipsis}" Margin="0,14,0,12" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Command="{Binding Chat.ChooseFolderCommand}" />
                    <Border Height="1" Background="#DCE1D5" Margin="0,0,0,14" />
                    <Border Background="#F9FAF6" BorderBrush="#DCE1D5" BorderThickness="1" CornerRadius="9" Padding="10" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Button DockPanel.Dock="Right" Content="{local:Loc Refresh}" Command="{Binding Chat.RefreshAccountCommand}" Style="{StaticResource QuietButton}" Padding="3,1" FontSize="10" />
                                <TextBlock Text="{local:Loc Account}" FontSize="10" Foreground="#76816E" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding Chat.AccountTitle}" ToolTip="{Binding Chat.AccountTitle}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Chat.Account.AccountType}" FontSize="11" Foreground="#6B7465" Margin="0,4,0,7" />
                            <ItemsControl ItemsSource="{Binding Chat.Account.LimitLines}" ToolTip="{Binding Chat.Account.ResetInfo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Chat.Account.ResetInfo}" TextWrapping="Wrap" Foreground="#76816E" FontSize="10" />
                            <TextBlock Text="{local:Loc Refreshing}" FontSize="10" Foreground="#76816E" Margin="0,5,0,0" Visibility="{Binding Chat.AccountLoading, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding Chat.AccountError}" FontSize="11" Foreground="#93622D" TextWrapping="Wrap" Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.AccountError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="8,0" Text="{local:Loc LocalHistory}" FontSize="11" Foreground="#6B7465" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <Button Content="{local:Loc SignIn}" Margin="0,10,0,0" Command="{Binding SignInCommand}" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <Button Margin="0,10,0,0" Content="{local:Loc Settings}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Click="Settings_OnClick" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Chat.ChatRows}" SelectedItem="{Binding Chat.SelectedEntry, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource NavigationItem}" IsEnabled="{Binding Chat.CanChangeContext}" AutomationProperties.Name="{local:Loc ProjectsAndChats}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ChatEntry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ProjectEntry}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#E9EBE5" BorderThickness="0,0,0,1" Padding="16,14">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="{local:Loc Projects}" Style="{StaticResource QuietButton}" Margin="0,0,12,0" Click="ToggleNavigation_OnClick" ToolTip="{local:Loc ProjectsTip}" />
                    <Button x:Name="FilesButton" DockPanel.Dock="Right" Content="{local:Loc Files}" Style="{StaticResource QuietButton}" Click="ToggleFiles_OnClick" ToolTip="{local:Loc FilesTip}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Chat.ChatTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Chat.ProjectName}" ToolTip="{Binding Chat.ProjectPath}" FontSize="11" Foreground="#758071" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <ListBox x:Name="Transcript" Style="{StaticResource TranscriptList}" ItemContainerStyle="{StaticResource TranscriptItem}" ItemsSource="{Binding Chat.Items}" ScrollViewer.ScrollChanged="Transcript_OnScrollChanged" AutomationProperties.Name="{local:Loc Conversation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="28,8,28,12">
                                <Border x:Name="Message" MaxWidth="760" Padding="0,8" HorizontalAlignment="Stretch">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" AutomationProperties.Name="{local:Loc CopyMessage}" />
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#71806A" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" Text="{Binding Body, Mode=OneWay}" MaxHeight="240" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCodeBlock, Converter={StaticResource BoolVis}}" />
                                        <Expander Header="{local:Loc ToolDetails}" FontSize="11" Foreground="#71806A" Visibility="{Binding IsTool, Converter={StaticResource BoolVis}}">
                                            <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" Foreground="#242824" FontFamily="Consolas" FontSize="12" Text="{Binding Body, Mode=OneWay}" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                                        </Expander>
                                        <local:MarkdownView Source="{Binding Body}" Visibility="{Binding IsCode, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Message" Property="Background" Value="#EBEEE5" />
                                    <Setter TargetName="Message" Property="CornerRadius" Value="12" />
                                    <Setter TargetName="Message" Property="Padding" Value="16,12" />
                                    <Setter TargetName="Message" Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCode}" Value="True">
                                    <Setter TargetName="Message" Property="Background" Value="#F0F1ED" />
                                    <Setter TargetName="Message" Property="BorderBrush" Value="#E3E6DD" />
                                    <Setter TargetName="Message" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="Message" Property="CornerRadius" Value="8" />
                                    <Setter TargetName="Message" Property="Padding" Value="12" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel MaxWidth="430" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Chat.Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{local:Loc EmptyTitle}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:Loc EmptyIntro}" FontSize="14" Foreground="#7A8273" TextAlignment="Center" Margin="0,12,0,24" />
                    <Button Content="{local:Loc OpenProject}" Command="{Binding Chat.ChooseFolderCommand}" HorizontalAlignment="Center" Padding="20,9" />
                    <TextBlock Text="{local:Loc SignInHint}" FontSize="12" Foreground="#7A8273" TextAlignment="Center" Margin="0,16,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                </StackPanel>
                <Button x:Name="LatestButton" Content="{local:Loc LatestReply}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="Latest_OnClick" Visibility="Collapsed" />
            </Grid>
            <StackPanel Grid.Row="2" Margin="24,8,24,14" MaxWidth="820">
                <Border Background="#F0F3EB" BorderBrush="#D9E2D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Visibility="{Binding HasUserCode, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc FinishSignIn}" FontWeight="SemiBold" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="{local:Loc CancelSignIn}" Style="{StaticResource QuietButton}" Command="{Binding StopCommand}" />
                            <Button DockPanel.Dock="Right" Content="{local:Loc CopyCodeAction}" Style="{StaticResource QuietButton}" Command="{Binding CopyCodeCommand}" />
                            <TextBlock Text="{Binding UserCode}" FontFamily="Consolas" FontSize="20" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button Content="{local:Loc CopySignInLink}" Style="{StaticResource QuietButton}" Command="{Binding CopyLinkCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Background="#FFF6E8" BorderBrush="#E9D4AC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Visibility="{Binding Chat.PermissionVisible, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Chat.PermissionTitle}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Chat.PermissionBody, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MaxHeight="130" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{local:Loc Allow}" Command="{Binding Chat.AllowCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                            <Button Content="{local:Loc Deny}" Command="{Binding Chat.DenyCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Chat.Activity}" Foreground="#64765A" FontSize="12" Margin="4,0,0,8" Visibility="{Binding Chat.HasActivity, Converter={StaticResource BoolVis}}" />
                <Border Background="White" BorderBrush="#DDE2D6" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid MinHeight="52">
                            <TextBox x:Name="Draft" Text="{Binding Chat.Draft, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" MaxHeight="140" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Draft_OnPreviewKeyDown" AutomationProperties.Name="{local:Loc MessageArni}" />
                            <TextBlock Text="{local:Loc DraftHint}" Foreground="#969E8E" IsHitTestVisible="False" Margin="1,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.Draft}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <DockPanel Grid.Row="1" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="{local:Loc Send}" Style="{StaticResource PrimaryButton}" Command="{Binding Chat.SendCommand}" Visibility="{Binding Chat.IsBusy, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                            <Button DockPanel.Dock="Right" Content="{local:Loc StopAction}" Command="{Binding Chat.StopCommand}" Visibility="{Binding Chat.IsBusy, Converter={StaticResource BoolVis}}" />
                            <Grid Margin="0,0,10,0" IsEnabled="{Binding Chat.CanChangeContext}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Loc Agent}" FontSize="11" Foreground="#64765A" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{local:Loc AgentTip}" />
                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <ComboBox ItemsSource="{Binding Chat.Models}" DisplayMemberPath="Display" SelectedItem="{Binding Chat.SelectedCatalog}" BorderThickness="0" Background="#F4F5F0" Padding="5" VerticalAlignment="Center" ToolTip="{local:Loc ModelTip}" AutomationProperties.Name="{local:Loc Model}" />
                                    <TextBlock Text="{Binding Chat.ModelStatus}" Foreground="#7D8773" FontSize="11" Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Chat.SelectedCatalog}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{local:Loc EnterHint}" FontSize="10" Foreground="#8B9482" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
        </Grid>
        <Border x:Name="Inspector" Grid.Column="2" Background="#F4F5F0" BorderBrush="#E0E4D9" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="{local:Loc Close}" Style="{StaticResource QuietButton}" Click="ToggleFiles_OnClick" FontSize="11" />
                        <TextBlock Text="{local:Loc ProjectFiles}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Chat.ProjectName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Chat.ProjectPath}" />
                    <TextBlock Text="{local:Loc LocalPreviewHint}" FontSize="10" Foreground="#7D8773" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <Button Content="{local:Loc OpenExplorer}" Command="{Binding Chat.OpenInExplorerCommand}" Margin="0,0,0,18" FontSize="12" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{local:Loc PreviewTextLimit}" FontSize="10" Foreground="#8B9482" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding Chat.HasTextPreview, Converter={StaticResource BoolVis}}" />
                <Grid>
                    <StackPanel Visibility="{Binding Chat.HasProject, Converter={StaticResource BoolVis}, ConverterParameter=invert}" Margin="0,20">
                        <TextBlock Text="{local:Loc NoProjectTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{local:Loc NoProjectHelp}" Foreground="#7D8773" TextWrapping="Wrap" Margin="0,8,0,16" />
                        <Button Content="{local:Loc AddProject}" Command="{Binding Chat.ChooseFolderCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Chat.ProjectFiles}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Chat.HasProject}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Chat.HasFilePreview}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Padding="8" FontSize="12" Command="{Binding DataContext.Chat.OpenProjectFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Visibility="{Binding Chat.HasFilePreview, Converter={StaticResource BoolVis}}">
                        <StackPanel DockPanel.Dock="Top">
                            <Button Content="{local:Loc BackToFiles}" Command="{Binding Chat.ClosePreviewCommand}" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" />
                            <TextBlock Text="{Binding Chat.FilePreviewTitle}" FontWeight="SemiBold" Margin="0,12" TextTrimming="CharacterEllipsis" />
                            <CheckBox Content="{local:Loc WrapText}" IsChecked="{Binding Preferences.WrapText}" Margin="0,0,0,12" FontSize="11" Visibility="{Binding Chat.HasTextPreview, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                        <Grid>
                            <TextBox x:Name="FilePreviewText" Text="{Binding Chat.FilePreviewBody, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" Visibility="{Binding Chat.HasTextPreview, Converter={StaticResource BoolVis}}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Preferences.WrapText}" Value="True"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="HorizontalScrollBarVisibility" Value="Disabled" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <local:MediaPreviewControl x:Name="PreviewPlayer" SourcePath="{Binding Chat.FilePreviewPath}" IsAudio="{Binding Chat.IsAudioPreview}" Visibility="{Binding Chat.HasMediaPreview, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
        <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Right" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" ShowsPreview="True" Background="Transparent" Visibility="Collapsed" ToolTip="{local:Loc ResizeFiles}" />
    </Grid>
</Window>
