<Window x:Class="ArniLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Arni Lite"
        Width="1080"
        Height="720"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="22" Text="Arni Lite" />
            <TextBlock Margin="0,4,0,12" Text="{Binding StatusLine}" TextWrapping="Wrap" />
            <TextBlock FontSize="28" FontFamily="Consolas" HorizontalAlignment="Left" Text="{Binding UserCode}" />
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button MinWidth="140" Margin="0,0,8,8" Padding="10,6" Content="Войти" Command="{Binding SignInCommand}" />
            <Button MinWidth="160" Margin="0,0,8,8" Padding="10,6" Content="Скопировать ссылку" Command="{Binding CopyLinkCommand}" />
            <Button MinWidth="140" Margin="0,0,8,8" Padding="10,6" Content="Яндекс" Command="{Binding YandexCommand}" />
            <Button MinWidth="140" Margin="0,0,8,8" Padding="10,6" Content="Google" Command="{Binding GoogleCommand}" />
            <Button MinWidth="180" Margin="0,0,8,8" Padding="10,6" Content="Проверить PowerShell" Command="{Binding PowerShellCommand}" />
            <Button MinWidth="160" Margin="0,0,8,8" Padding="10,6" Content="Проверить поток" Command="{Binding StreamCommand}" />
            <Button MinWidth="100" Margin="0,0,8,8" Padding="10,6" Content="Стоп" Command="{Binding StopCommand}" />
            <Button MinWidth="100" Margin="0,0,8,8" Padding="10,6" Content="Выйти" Command="{Binding SignOutCommand}" />
        </WrapPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Margin="0,0,12,0"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     IsReadOnly="True"
                     Text="{Binding Log, Mode=OneWay}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Редактор G0. Полноценный чат и агент сюда ещё не входят." />
                <avalonedit:TextEditor x:Name="Editor"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
