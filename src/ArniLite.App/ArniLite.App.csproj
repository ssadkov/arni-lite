<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ArniLite.ico</ApplicationIcon>
    <RootNamespace>ArniLite</RootNamespace>
    <AssemblyName>ArniLite</AssemblyName>
    <Version>0.1.2</Version>
    <RuntimeIdentifiers>win7-x86;win7-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="..\ArniLite.Api\ArniLite.Api.csproj" />
    <ProjectReference Include="..\ArniLite.Core\ArniLite.Core.csproj" />
    <ProjectReference Include="..\ArniLite.Storage\ArniLite.Storage.csproj" />
    <ProjectReference Include="..\ArniLite.Windows\ArniLite.Windows.csproj" />
  </ItemGroup>
</Project>
