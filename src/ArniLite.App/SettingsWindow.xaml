<Window x:Class="ArniLite.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArniLite"
        Title="{local:Loc Settings}" Width="760" Height="660" MinWidth="580" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="#FAFAF8" FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="22">
        <Button DockPanel.Dock="Bottom" Content="{local:Loc Close}" HorizontalAlignment="Right" MinWidth="90" Margin="0,14,0,0" IsCancel="True" Click="Close_OnClick" />
        <TextBlock DockPanel.Dock="Top" Text="{local:Loc Settings}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
        <TabControl x:Name="SettingsTabs" Background="Transparent" BorderBrush="#DDE2D6">
            <TabItem Header="{local:Loc General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{local:Loc Language}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ComboBox ItemsSource="{Binding Preferences.Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding Preferences.Language}" Width="230" HorizontalAlignment="Left" Padding="8"
                                  AutomationProperties.Name="{local:Loc Language}" />
                        <TextBlock Text="{local:Loc Preview}" FontWeight="SemiBold" Margin="0,24,0,12" />
                        <CheckBox Content="{local:Loc WrapText}" IsChecked="{Binding Preferences.WrapText}" />
                        <TextBlock Text="{local:Loc Agent}" FontWeight="SemiBold" Margin="0,24,0,12" />
                        <CheckBox Content="{local:Loc FreeModelsOnly}" IsChecked="{Binding Chat.FreeOnly}" IsEnabled="{Binding Chat.CanChangeContext}" Margin="0,0,0,12" />
                        <CheckBox Content="{local:Loc SessionTrust}" IsChecked="{Binding Chat.TrustSession}" IsEnabled="{Binding Chat.CanChangeContext}" />
                        <Button Content="{local:Loc SignOut}" Command="{Binding SignOutCommand}" HorizontalAlignment="Left" Margin="0,24,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding Preferences.SaveError}" Foreground="#93622D" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc Dictation}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="{local:Loc SpeechDescription}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Dictation.InstallationStatus}" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="{local:Loc SpeechInstall}" Command="{Binding Dictation.InstallCommand}" Margin="0,0,8,8" />
                        <Button Content="{local:Loc SpeechRemove}" Command="{Binding Dictation.RemoveCommand}" Margin="0,0,8,8" />
                        <Button Content="{local:Loc Cancel}" Command="{Binding Dictation.CancelCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <ProgressBar Value="{Binding Dictation.Progress, Mode=OneWay}" Height="5" Margin="0,4,0,12" Visibility="{Binding Dictation.IsBusy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Dictation.Status}" TextWrapping="Wrap" Foreground="#64765A" Margin="0,0,0,16" Visibility="{Binding Dictation.HasStatus, Converter={StaticResource BoolVis}}" />
                    <StackPanel IsEnabled="{Binding Dictation.IsActive, Converter={StaticResource InvertBool}}">
                        <TextBlock Text="{local:Loc SpeechLanguage}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Dictation.Languages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Dictation.Language}" Width="260" HorizontalAlignment="Left" />
                        <TextBlock Text="{local:Loc SpeechMicrophone}" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <ComboBox ItemsSource="{Binding Dictation.Microphones}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Dictation.MicrophoneId}" />
                        <Button Content="{local:Loc SpeechRefreshDevices}" Command="{Binding Dictation.RefreshDevicesCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                    <TextBlock Text="{local:Loc SpeechPrivacy}" TextWrapping="Wrap" FontSize="12" Foreground="#6B7465" Margin="0,20,0,0" />
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc Updates}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="{local:Loc UpdateDescription}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <WrapPanel Margin="0,0,0,14"><TextBlock Text="{local:Loc Version}" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:AppVersion.Display}" FontWeight="SemiBold" /></WrapPanel>
                    <StackPanel IsEnabled="{Binding Updates.IsBusy, Converter={StaticResource InvertBool}}">
                        <CheckBox Content="{local:Loc UpdateAutomatic}" IsChecked="{Binding Updates.Automatic}" Margin="0,0,0,12" />
                        <CheckBox Content="{local:Loc UpdatePreview}" IsChecked="{Binding Updates.Preview}" Margin="0,0,0,16" />
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,16"><TextBlock Text="{local:Loc UpdateLastChecked}" Margin="0,0,12,0" /><TextBlock Text="{Binding Updates.LastChecked}" /></WrapPanel>
                    <TextBlock Text="{Binding Updates.Status}" TextWrapping="Wrap" Foreground="#64765A" Margin="0,0,0,16" />
                    <ProgressBar Value="{Binding Updates.Progress, Mode=OneWay}" Height="5" Margin="0,0,0,12" Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolVis}}" />
                    <WrapPanel>
                        <Button Content="{local:Loc UpdateCheck}" Command="{Binding Updates.CheckCommand}" Margin="0,0,8,8" />
                        <Button Content="{local:Loc Cancel}" Command="{Binding Updates.CancelCommand}" Margin="0,0,8,8" />
                        <Button Content="{local:Loc UpdateGitHub}" Click="Releases_OnClick" Margin="0,0,8,8" />
                    </WrapPanel>
                    <WrapPanel Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolVis}}">
                        <Button Content="{local:Loc UpdateDownload}" Command="{Binding Updates.DownloadCommand}" Margin="0,0,8,8" />
                        <Button Content="{local:Loc UpdateInstall}" Command="{Binding Updates.InstallCommand}" Margin="0,0,8,8" />
                        <Button Content="{local:Loc UpdateReleaseNotes}" Command="{Binding Updates.ReleaseCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{local:Loc UpdateIdleOnly}" TextWrapping="Wrap" FontSize="12" Foreground="#6B7465" Margin="0,14,0,0" />
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc About}">
                <StackPanel Margin="20">
                    <TextBlock Text="Arni Lite" FontSize="26" FontWeight="SemiBold" />
                    <DockPanel Margin="0,20,0,0">
                        <TextBlock Text="{local:Loc Version}" Width="130" />
                        <TextBox Text="{x:Static local:AppVersion.Display}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0"><TextBlock Text="{local:Loc Platform}" Width="130" /><TextBlock Text="{x:Static local:AppVersion.Platform}" /></DockPanel>
                    <TextBox x:Name="AboutEnvironment" Text="{x:Static local:AppVersion.EnvironmentSummary}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Background="#F0F2EA" BorderThickness="0" Padding="10" Margin="0,24,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{local:Loc Diagnostics}">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="{local:Loc DiagnosticsPrivacy}" FontSize="12" Foreground="#6B7465" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{local:Loc ExportLogs}" Click="Export_OnClick" Margin="0,0,10,0" />
                            <Button Content="{local:Loc RefreshLogs}" Click="Refresh_OnClick" />
                        </WrapPanel>
                        <TextBlock x:Name="ExportStatus" TextWrapping="Wrap" Foreground="#64765A" FontSize="12" Margin="0,10,0,0" />
                    </StackPanel>
                    <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" BorderBrush="#DDE2D6"
                             Background="White" Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{local:Loc Diagnostics}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
