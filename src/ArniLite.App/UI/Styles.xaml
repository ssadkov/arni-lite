<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:ArniLite" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <local:BoolVisibilityConverter x:Key="BoolVis" />
    <local:InvertBoolConverter x:Key="InvertBool" />
    <local:CodeFontConverter x:Key="CodeFont" />
    <local:FolderNameConverter x:Key="FolderName" />
    <Style TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#1C1C1C" />
        <Setter Property="BorderBrush" Value="#D7D7D2" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#F7F7F5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#6A6A66" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{local:Loc Copy}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Width="28" Height="28">
                        <Viewbox Width="14" Height="14">
                            <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent" Data="M5 7h7v8H5z M8 7V5h7v8h-2" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#E7E5E0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#1C1C1C" />
        <Setter Property="BorderBrush" Value="#1C1C1C" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="#1C1C1C" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#333333" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="MenuTop" TargetType="MenuItem">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Head" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,4">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="False" Focusable="False" PopupAnimation="None" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PlacementTarget="{Binding ElementName=Head}">
                <Border Background="White" BorderBrush="#808080" BorderThickness="1" Padding="2" MinWidth="220" SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Head" Property="Background" Value="#E6E6E6" />
                <Setter TargetName="Head" Property="BorderBrush" Value="#B0B0B0" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Head" Property="Background" Value="#E6E6E6" />
                <Setter TargetName="Head" Property="BorderBrush" Value="#808080" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="MenuSub" TargetType="MenuItem">
        <Border x:Name="Row" Background="Transparent" Padding="8,5" SnapsToDevicePixels="True">
            <DockPanel>
                <Path x:Name="Mark" DockPanel.Dock="Left" Width="12" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" Stroke="#1C1C1C" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M1,5 L4,8 L11,1" Fill="Transparent" />
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#D6E3F6" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#1C1C1C" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuTop}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuTop}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuSub}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuSub}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#D0D0D0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#E7EAE3" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#DEE6D9" />
                            <Setter Property="Foreground" Value="#21402C" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="#42644B" />
                            <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,16,0,4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="ChatEntry">
        <TextBlock Text="{Binding Title}" Margin="18,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
    </DataTemplate>
    <DataTemplate x:Key="ProjectEntry">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="+" Padding="6,2" FontSize="17" Style="{StaticResource QuietButton}" ToolTip="{local:Loc NewProjectChat}" AutomationProperties.Name="{local:Loc NewProjectChat}" Command="{Binding DataContext.Chat.NewProjectChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ProjectPath}" />
            <Button Style="{StaticResource QuietButton}" Padding="6,3" HorizontalContentAlignment="Left" ToolTip="{Binding ProjectPath}" Command="{Binding DataContext.Chat.ToggleProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ProjectPath}">
                <DockPanel>
                    <TextBlock Text="{Binding Disclosure}" Width="18" Foreground="#758071" />
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#616B5E" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
        </DockPanel>
    </DataTemplate>
    <Style x:Key="TranscriptItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TranscriptList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
