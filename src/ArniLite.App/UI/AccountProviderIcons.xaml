    <Style x:Key="AccountProviderIcon" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Source" Value="{StaticResource DefaultAccountIcon}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Chat.Account.AuthProvider}" Value="yandex">
                <Setter Property="Source" Value="{StaticResource YandexAccountIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Chat.Account.AuthProvider}" Value="google">
                <Setter Property="Source" Value="{StaticResource GoogleAccountIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Chat.Account.AuthProvider}" Value="vk">
                <Setter Property="Source" Value="{StaticResource VkAccountIcon}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
